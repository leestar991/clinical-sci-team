# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.coverage
.coverage.*
.ruff_cache
agent_history.gif
static/browser_history/*.gif

log/
log/*

# Virtual environments
.venv
venv/

# User config file
config.yaml

# Langgraph
.langgraph_api

# Sandbox runtime working dir — pre-created and excluded from uvicorn reload
# (scripts/serve.sh, docker/dev-entrypoint.sh). Anchored so it does not match
# the source package backend/packages/harness/deerflow/sandbox/.
/sandbox/

# Claude Code settings
.claude/settings.local.json

# ── DeerFlow 运行时数据:全部忽略,唯 agents/ 自定义 agent 定义例外 ──
# (模式相对本文件所在目录:.deer-flow/* 只管 backend/.deer-flow/;根 .gitignore 管根下同名目录)
.deer-flow/*
!.deer-flow/agents/
.deer-flow/agents/*/memory.json
.deer-flow/agents/**/.DS_Store
# 上方全局 `config.yaml` 会误伤 agent 定义(name/tool_groups/skills 白名单,SOUL.md 的配套),显式放行:
!.deer-flow/agents/*/config.yaml
