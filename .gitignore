# DeerFlow docker image cache
docker/.cache/
# oh-my-claudecode state
.omc/
# OS generated files
.DS_Store
*.local
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv
venv/

# Environment variables
.env

# Configuration files
config.yaml
mcp_config.json
extensions_config.json

# IDE
.idea/
.vscode/

# Coverage report
coverage.xml
coverage/

.claude/
logs/
log/
debug.log

# Local git hooks (keep only on this machine, do not push)
.githooks/

# pnpm
.pnpm-store
sandbox_image_cache.tar

# ignore the legacy `web` folder
web/

# Runtime data
checkpoints.db
**/memory.json

# Deployment artifacts
backend/Dockerfile.langgraph
config.yaml.bak
.playwright-mcp
/frontend/test-results/
/frontend/playwright-report/
.gstack/
.worktrees
temp/**
skills/custom/**

# ── DeerFlow 运行时数据:全部忽略,唯 agents/ 自定义 agent 定义例外 ──
.deer-flow/*
!.deer-flow/agents/
.deer-flow/agents/*/memory.json
.deer-flow/agents/**/.DS_Store
# agent 定义是 SOUL.md 的配套(name/tool_groups/skills 白名单),随 SOUL 一同入库;
# 上方全局 `config.yaml` 会误伤,显式放行(白名单必须写在被覆盖规则之后):
!.deer-flow/agents/*/config.yaml
